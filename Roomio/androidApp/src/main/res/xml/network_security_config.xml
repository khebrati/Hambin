<?xml version="1.0" encoding="utf-8"?>
<!--
  Direct video URLs are user-supplied and may use plain HTTP, so cleartext
  traffic is permitted. HTTPS remains the default for every other host.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
