# Hambin backend configuration. Copy to .env and fill in real values.
# Never commit a populated .env file, and keep it readable only by you:
#   cp .env.example .env && chmod 600 .env
#
# Generate secrets with:
#   openssl rand -hex 32

# Application
HAM_APP_ENV=production
HAM_HTTP_ADDR=:8080
HAM_LOG_LEVEL=info

# PostgreSQL (docker compose overrides HAM_DATABASE_URL with the internal URL)
POSTGRES_USER=hambin
POSTGRES_PASSWORD=change-me-openssl-rand-hex-32
POSTGRES_DB=hambin
HAM_DATABASE_URL=postgres://hambin:change-me-openssl-rand-hex-32@postgres:5432/hambin?sslmode=disable

# Tokens
HAM_ACCESS_TOKEN_SECRET=change-me-openssl-rand-hex-32
HAM_ACCESS_TOKEN_TTL=15m
HAM_REFRESH_TOKEN_TTL=2160h
HAM_REALTIME_TICKET_TTL=30s

# Room lifecycle
HAM_DISCONNECT_GRACE=30s
HAM_TOMBSTONE_TTL=24h
HAM_PLAYBACK_REPORT_TTL=15s
HAM_PLAYBACK_SYNC_WINDOW=15s
HAM_OUTBOX_PERIOD=250ms

# Rate limiting
HAM_RATE_LIMIT_PER_MINUTE=120

# LiveKit voice. These two secrets are shared by the LiveKit container and the
# API (docker compose derives HAM_LIVEKIT_* from them), so they can never drift.
# Leave LIVEKIT_API_KEY and LIVEKIT_API_SECRET blank to disable voice entirely.
HAM_LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=change-me-openssl-rand-hex-16
LIVEKIT_API_SECRET=change-me-openssl-rand-hex-32
HAM_LIVEKIT_TOKEN_TTL=5m

# Public domains (DNS A records pointing at the VM's Elastic IP)
HAM_DOMAIN=api.example.com
HAM_LIVEKIT_DOMAIN=livekit.example.com
HAM_TURN_DOMAIN=turn.example.com
