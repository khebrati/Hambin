# Copy to /opt/hambin/.env with mode 0600. Generate fresh passwords outside Git.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
TURN_SHARED_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SITE_DOMAIN=watchparty.top
TURN_DOMAIN=relay.watchparty.top
PUBLIC_IP=REPLACE_WITH_SERVER_PUBLIC_IP
RELEASE_ID=REPLACE_WITH_RELEASE_ID
# Capacity settings are ceilings to measure, not a verified concurrency claim.
TURN_MIN_PORT=49160
TURN_MAX_PORT=65535
TURN_USER_QUOTA=128
TURN_TOTAL_QUOTA=16000
TURN_MAX_BPS=256000
TURN_BPS_CAPACITY=512000000
