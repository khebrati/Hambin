AVPlayer 1.3.1: reset the subtitle queue before demux seeking.
Watch Party modification, 2026-11-06. Same LGPL-3.0-or-later terms as upstream.

MSE.afterSeek can enqueue the subtitle that spans the target timestamp.
Resetting the renderer afterward loses that cue until the following subtitle.
Reset before the seek instead; restart after new packets are available.
scripts/prepare-player-assets.mjs applies this equivalent change to the pinned
published UMD build and refuses an unrecognized upstream method.

--- a/packages/avplayer/src/AVPlayer.ts
+++ b/packages/avplayer/src/AVPlayer.ts
@@ -2891,6 +2891,9 @@
   private async doSeek(timestamp: int64, streamIndex: int32, options: {
     onBeforeSeek?: Function
   } = {}) {
+    if (defined(ENABLE_SUBTITLE_RENDER) && this.subtitleRender) {
+      this.subtitleRender.reset()
+    }
 
     if (defined(ENABLE_MSE) && this.useMSE) {
       await AVPlayer.MSEThread.beforeSeek(this.taskId)
@@ -3006,7 +3009,6 @@
       }
     }
     if (defined(ENABLE_SUBTITLE_RENDER) && this.subtitleRender) {
-      this.subtitleRender.reset()
       this.subtitleRender.start()
     }
   }
