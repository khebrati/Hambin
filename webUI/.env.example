# Copy to .env.local for the local Node/PostgreSQL stack.
BACKEND_PROXY_TARGET=http://127.0.0.1:8081
# Leave empty for same-origin HTTP and Socket.IO. Hosted ingress must proxy both.
VITE_BACKEND_URL=

# Optional observability ingestion identifiers. Development capture is off by default.
VITE_SENTRY_DSN=
VITE_POSTHOG_TOKEN=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# VITE_OBSERVABILITY_ENABLED=true
# VITE_OBSERVABILITY_ENVIRONMENT=development
# Supply SENTRY_AUTH_TOKEN only in the build environment to upload hidden source maps.
